---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, tagSlug } from '../../lib/posts';

const posts = await getPosts();
const tags = Array.from(new Set(posts.flatMap((p) => p.data.tags))).sort();
---

<Base title="Blog" description="Notes on hiring, screening and building engineering teams from GrowthEngine.">

  <section class="listing-hero">
    <div class="container">
      <h1>All blog posts</h1>

      <div class="search-bar">
        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="search" placeholder="Search articles..." class="search-input" id="search-input" aria-label="Search articles" />
      </div>

      {tags.length > 0 && (
        <div class="tags-row" id="tags-row">
          <button type="button" class="tag-pill tag-active" data-tag="">All</button>
          {tags.map((tag) => (
            <button type="button" class="tag-pill" data-tag={tagSlug(tag)}>{tag}</button>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="posts-grid" id="posts-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <div id="search-results" hidden></div>
    </div>
  </section>

</Base>

<style>
  .listing-hero {
    background: var(--white);
    padding: 48px 0;
    text-align: center;
    border-bottom: 1px solid var(--gray-200);
  }

  .listing-hero h1 {
    margin-bottom: 28px;
  }

  .search-bar {
    position: relative;
    max-width: 520px;
    margin: 0 auto 28px;
  }

  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gray-400);
  }

  .search-input {
    width: 100%;
    padding: 14px 16px 14px 48px;
    font-size: 1rem;
    font-family: var(--font);
    border: 1px solid var(--gray-200);
    border-radius: 0;
    outline: none;
    transition: border-color 0.2s;
    background: var(--gray-100);
  }

  .search-input:focus {
    border-color: var(--black);
    background: var(--white);
  }

  .search-input::placeholder {
    color: var(--gray-400);
  }

  .tags-row {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .tag-pill {
    padding: 8px 20px;
    font-size: 0.9rem;
    font-family: var(--font);
    font-weight: 500;
    background: var(--white);
    border: 1px solid var(--gray-200);
    color: var(--gray-600);
    transition: all 0.2s;
    cursor: pointer;
  }

  .tag-pill:hover {
    border-color: var(--black);
    color: var(--black);
  }

  .tag-pill.tag-active {
    background: var(--black);
    color: var(--white);
    border-color: var(--black);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 32px;
  }

  #search-results {
    min-height: 200px;
    max-width: 800px;
    margin: 0 auto;
  }

  #search-results :global(.search-result) {
    padding: 24px 0;
    border-bottom: 1px solid var(--gray-200);
  }

  #search-results :global(.search-result a) {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--black);
    display: block;
    margin-bottom: 8px;
  }

  #search-results :global(.search-result a:hover) {
    color: var(--accent);
  }

  #search-results :global(.search-result p) {
    font-size: 0.95rem;
    color: var(--gray-600);
    line-height: 1.6;
  }

  #search-results :global(mark) {
    background: #fef08a;
    color: inherit;
    padding: 1px 2px;
  }

  @media (max-width: 768px) {
    .listing-hero {
      padding: 32px 0;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (function () {
    var input = document.getElementById('search-input');
    var grid = document.getElementById('posts-grid');
    var results = document.getElementById('search-results');
    var tagsRow = document.getElementById('tags-row');
    var pagefind = null;

    // Tag filter (also reads ?tag=... so tag links on posts land filtered)
    function setTag(tag) {
      if (tagsRow) {
        tagsRow.querySelectorAll('.tag-pill').forEach(function (b) {
          b.classList.toggle('tag-active', b.getAttribute('data-tag') === tag);
        });
      }
      grid.querySelectorAll('.post-card').forEach(function (card) {
        var tags = (card.getAttribute('data-tags') || '').split(' ');
        card.style.display = !tag || tags.indexOf(tag) !== -1 ? '' : 'none';
      });
    }

    if (tagsRow) {
      tagsRow.addEventListener('click', function (e) {
        var btn = e.target.closest('.tag-pill');
        if (btn) setTag(btn.getAttribute('data-tag'));
      });
    }
    var initial = new URLSearchParams(location.search).get('tag');
    if (initial) setTag(initial);

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    // Full-text search with Pagefind (the index is built by `npm run build`)
    input.addEventListener('input', async function () {
      var query = input.value.trim();
      if (!query) {
        grid.hidden = false;
        results.hidden = true;
        results.innerHTML = '';
        return;
      }
      if (!pagefind) {
        try {
          pagefind = await import('/pagefind/pagefind.js');
          await pagefind.init();
        } catch (e) {
          return;
        }
      }
      var search = await pagefind.debouncedSearch(query);
      if (!search || input.value.trim() !== query) return;
      var found = await Promise.all(search.results.slice(0, 10).map(function (r) { return r.data(); }));

      grid.hidden = true;
      results.hidden = false;
      if (found.length === 0) {
        results.innerHTML = '<p style="color:var(--gray-400);text-align:center;padding:40px 0;">No results found.</p>';
        return;
      }
      results.innerHTML = found.map(function (r) {
        var title = r.meta && r.meta.title ? r.meta.title : 'Untitled';
        return '<div class="search-result"><a href="' + escapeHtml(r.url) + '">' + escapeHtml(title) + '</a><p>' + r.excerpt + '</p></div>';
      }).join('');
    });
  })();
</script>
