---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { render } from 'astro:content';
import { getPosts, formatDate, tagSlug, type Post } from '../../lib/posts';
import { CALENDLY_URL } from '../../config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

interface Props {
  post: Post;
  posts: Post[];
}

const { post, posts } = Astro.props;
const { Content } = await render(post);
const related = posts.filter((p) => p.id !== post.id).slice(0, 2);
---

<Base title={post.data.title} description={post.data.excerpt}>

  <article>
    {post.data.hero_image && (
      <div class="article-hero">
        <img src={post.data.hero_image} alt="" />
      </div>
    )}

    <div class="container article-content" data-pagefind-body>
      <a href="/blog" class="back-link" data-pagefind-ignore>&larr; Back to blog</a>

      {post.data.tags.length > 0 && (
        <div class="article-tags" data-pagefind-ignore>
          {post.data.tags.map((tag) => (
            <a href={`/blog?tag=${tagSlug(tag)}`} class="article-tag">{tag}</a>
          ))}
        </div>
      )}

      <h1 data-pagefind-meta="title">{post.data.title}</h1>

      <div class="article-meta" data-pagefind-ignore>
        <span class="article-author">{post.data.author}</span>
        <span class="article-date">{formatDate(post.data.date)}</span>
      </div>

      <div class="body">
        <Content />
      </div>

      <div class="article-cta" data-pagefind-ignore>
        <p>Want to talk it through? Set up a quick 30-minute call with our CEO.</p>
        <a href={CALENDLY_URL} target="_blank" rel="noopener" class="btn btn-primary">Talk to our CEO</a>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <h2 class="related-title">More Articles</h2>
        <div class="related-grid">
          {related.map((p) => <PostCard post={p} showMeta={false} />)}
        </div>
      </div>
    </section>
  )}

</Base>

<style>
  .article-hero {
    width: 100%;
    max-height: 480px;
    overflow: hidden;
  }

  .article-hero img {
    width: 100%;
    height: 480px;
    object-fit: cover;
  }

  .article-content {
    max-width: 720px;
    padding-top: 40px;
    padding-bottom: 64px;
  }

  .back-link {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--gray-400);
    margin-bottom: 32px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--black);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 16px;
  }

  .article-tag {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    padding: 4px 12px;
    border: 1px solid var(--accent);
    transition: all 0.2s;
  }

  .article-tag:hover {
    background: var(--accent);
    color: var(--white);
  }

  h1 {
    margin-bottom: 16px;
    text-wrap: balance;
  }

  .article-meta {
    display: flex;
    gap: 16px;
    font-size: 0.9rem;
    color: var(--gray-400);
    margin-bottom: 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--gray-200);
  }

  .article-author {
    font-weight: 500;
    color: var(--gray-600);
  }

  .body {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--gray-800);
  }

  .body :global(h2) {
    font-size: 1.5rem;
    margin: 40px 0 16px;
    color: var(--black);
  }

  .body :global(h3) {
    font-size: 1.25rem;
    margin: 32px 0 12px;
    color: var(--black);
  }

  .body :global(p) {
    margin-bottom: 20px;
    color: var(--gray-800);
  }

  .body :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }

  .body :global(ul),
  .body :global(ol) {
    margin-bottom: 20px;
    padding-left: 24px;
  }

  .body :global(li) {
    margin-bottom: 8px;
  }

  .body :global(blockquote) {
    border-left: 3px solid var(--black);
    padding-left: 20px;
    margin: 24px 0;
    color: var(--gray-600);
    font-style: italic;
  }

  .body :global(img) {
    margin: 24px 0;
    border: 1px solid var(--gray-200);
  }

  .article-cta {
    margin-top: 48px;
    padding: 32px;
    background: var(--gray-100);
    text-align: center;
  }

  .article-cta p {
    margin-bottom: 20px;
    color: var(--gray-800);
  }

  .related-title {
    text-align: center;
    margin-bottom: 40px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 32px;
    max-width: 900px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .article-hero img {
      height: 240px;
    }

    .article-content {
      padding-top: 24px;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
